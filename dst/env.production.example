#--------------------------------------------------------------------
# CoreLynk - PRODUCTION .env
# Copy to ".env" on the server:  cp env.production.example .env
# NEVER commit the real .env to git.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Must end with a slash. Use https:// if you have SSL.
app.baseURL = 'https://your-domain.com/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = corelynk_db
database.default.username = corelynk
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.collation = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# KEEP THE SAME VALUE AS THE CURRENT LIVE SERVER.
# Changing it invalidates every existing session/cookie and any
# encrypted column. New install only:  php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# SESSION / COOKIES
#--------------------------------------------------------------------
# Do NOT set session.savePath here. Leaving it unset makes CI4 use
# writable/session (app/Config/Session.php). The old dev value
# "'/writable/session'" is what created the stray public/C_ and
# public/null folders full of ci_session* files.
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# Leave cookie.domain empty to use the request host.
cookie.domain = ''
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
